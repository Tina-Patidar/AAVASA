# ---------- AAVASA client configuration ----------
# Copy to ".env" (local) or set in your hosting dashboard (Vercel).

# Base URL of the API.
#  - Local development: leave as /api (Vite proxies it to the Express server on port 5000)
#  - Production: the full URL of your deployed API, e.g. https://aavasa-api.onrender.com/api
VITE_API_URL=/api

# Only for local development: where the Vite dev server should forward /api requests
VITE_DEV_PROXY_TARGET=http://localhost:5000
