# ---------- AAVASA server configuration ----------
# Copy this file to ".env" and fill in the values. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas example (replace user, password, cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aavasa?retryWrites=true&w=majority
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/aavasa

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call this API. Comma-separate several values.
# Production example: https://your-aavasa-app.vercel.app
CLIENT_URL=http://localhost:5173

# Taxes and fees applied by the pricing service (percent)
TAX_RATE=12
SERVICE_FEE_RATE=3
