{
  "name": "aavasa-server",
  "version": "1.0.0",
  "description": "AAVASA - REST API for the hotel booking platform (Express + MongoDB)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "mongo": "node scripts/embeddedMongo.js",
    "seed": "node scripts/seed.js",
